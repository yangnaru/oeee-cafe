<!DOCTYPE html>
<html lang="{{ ftl_lang }}">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"/>
    <title>Replay</title>
    <style>
        body, html {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100%;
            background-color: #ddd;
            overflow: hidden;
        }
        body {
            display: flex;
            justify-content: center;
            align-items: center;
        }
    </style>
</head>
<body>
<div id="viewer"></div>
<script src="{{ '/static/viewer/oeee-replay.js' | cachebuster | safe }}"></script>
<script>
  OeeeReplay.mount(document.getElementById("viewer"), {
    replay: "{{ r2_public_endpoint_url|safe }}/replay/{{ post.replay_filename[:2] }}/{{ post.replay_filename }}",
    width: {{ post.image_width|int }},
    height: {{ post.image_height|int }},
  });
</script>
</body>
</html>
