{% extends "base.jinja" %}
{% block title %}
  {{ ftl_get_message("brand") }}
{% endblock title %}
{% block head %}
  <style>
    /* Wider than the 829px default so the grid has room to breathe, capped so
       it does not sprawl on an ultrawide monitor. The nav bar reads the same
       variable and follows automatically. */
    :root { --page-width: 1600px; }
    .thumbnail-size {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: .5rem;
      margin: 8px 0;
      font-size: .85rem;
    }
    .thumbnail-size input[type="range"] { max-width: 200px; }
    .thumbnail-size output {
      min-width: 1.5em;
      text-align: right;
      font-weight: bold;
    }
    /* Phones use a fixed three-column grid, so the control has nothing to do. */
    @media (max-width: 600px) {
      .thumbnail-size { display: none; }
    }
  </style>
  {# Applied before first paint so the grid does not flash at another width. #}
  <script>
    (function () {
      var saved = parseInt(localStorage.getItem("homeCols"), 10);
      if (saved > 0) {
        document.documentElement.style.setProperty("--home-cols", saved);
        document.documentElement.setAttribute("data-cols", "");
      }
    })();
  </script>
{% endblock head %}
{% block content %}
  <div class="center">
    {# The public post grid is the whole page: communities and recent comments
       moved off home. Cards come from home_posts_fragment.jinja so the first
       batch and every scrolled batch share one definition — the duplicate copy
       that used to live here is how the sentinel batch size drifted before. #}
    {% if posts and posts|length > 0 %}
      <section role="region" aria-labelledby="public-posts-heading">
        <h2 id="public-posts-heading" class="home-section-title">{{ ftl_get_message("posts-from-public-communities") }}</h2>
        <div class="thumbnail-size">
          <label for="post-cols">{{ ftl_get_message("home-thumbnail-size") }}</label>
          <input type="range" id="post-cols" min="1" step="1" />
          <output id="post-cols-value"></output>
        </div>
        <div class="posts-grid" id="public-posts-grid">
          {% include "home_posts_fragment.jinja" %}
        </div>
      </section>
    {% endif %}
    <script>
      (function () {
        // The slider sets the column count directly. Its maximum is whatever
        // the grid can fit at MIN_CARD px, recomputed on resize, so every step
        // always changes the layout by one column on any screen.
        var MIN_CARD = 90;
        var GAP = 8;
        var HARD_MAX = 12;
        var TARGET_CARD = 180;

        var slider = document.getElementById("post-cols");
        var readout = document.getElementById("post-cols-value");
        var grid = document.getElementById("public-posts-grid");
        if (!slider || !grid) return;
        var root = document.documentElement;
        // Must match the breakpoint in style.css that pins three columns.
        var phone = window.matchMedia("(max-width: 600px)");

        function fits(px) {
          var width = grid.clientWidth || window.innerWidth;
          return Math.max(1, Math.min(HARD_MAX, Math.floor((width + GAP) / (px + GAP))));
        }

        function apply(cols) {
          root.style.setProperty("--home-cols", cols);
          root.setAttribute("data-cols", "");
          slider.value = cols;
          readout.textContent = cols;
          localStorage.setItem("homeCols", cols);
        }

        function sync() {
          // On a phone the CSS owns the layout; touching storage here would let
          // a narrow visit overwrite a count chosen on a wider screen.
          if (phone.matches) return;
          var max = fits(MIN_CARD);
          slider.max = max;
          var stored = parseInt(localStorage.getItem("homeCols"), 10);
          // No stored preference: aim for roughly TARGET_CARD-wide thumbnails.
          var cols = stored > 0 ? stored : fits(TARGET_CARD);
          apply(Math.max(1, Math.min(max, cols)));
        }

        sync();
        slider.addEventListener("input", function () {
          if (phone.matches) return;
          apply(parseInt(slider.value, 10));
        });

        // Rotating a phone changes how many columns fit; re-clamp so a count
        // chosen on a wider layout does not leave slivers.
        var pending;
        window.addEventListener("resize", function () {
          clearTimeout(pending);
          pending = setTimeout(sync, 150);
        });
        // Rotating out of the phone breakpoint hands control back to the slider.
        if (phone.addEventListener) phone.addEventListener("change", sync);
      })();
    </script>
  </div>
{% endblock content %}
