{# Head fragment shared by the /, /home and /collaborate feeds: the pre-paint
   column restore. Included from each page's {% block head %} so the feeds
   cannot drift apart.

   No page-width override lives here any more. It used to widen the whole page
   to 1600px, which moved the header too — the logo and nav sat flush left on
   these three pages and centred everywhere else. The grid section opts into
   .center-wide instead, so only the grid is wide. #}
{# Applied before first paint so the grid does not flash at another width. #}
<script>
  (function () {
    var saved = parseInt(localStorage.getItem("homeCols"), 10);
    if (saved > 0) {
      document.documentElement.style.setProperty("--home-cols", saved);
      document.documentElement.setAttribute("data-cols", "");
    }
  })();
</script>
