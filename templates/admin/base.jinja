{% extends "base.jinja" %}
{# Staff-only chrome. The banner is deliberately loud: these pages show private
   communities, unpublished drafts and removed posts, so it should never be
   ambiguous which context you are looking at. #}
{% block title %}Admin · {{ ftl_get_message("brand") }}{% endblock title %}
{% block head %}
  <style>
    .admin-banner {
      background: #7a1020;
      color: #fff;
      padding: .5rem 1rem;
      margin-bottom: 1rem;
      font-weight: bold;
    }
    .admin-banner a { color: #fff; }
    .admin-nav { display: flex; gap: 1rem; margin-bottom: 1rem; flex-wrap: wrap; }
    .admin-filters { margin-bottom: 1rem; display: flex; gap: .75rem; align-items: end; flex-wrap: wrap; }
    .admin-grid { display: flex; flex-wrap: wrap; gap: .75rem; }
    .admin-card { width: 160px; font-size: .85rem; }
    /* Anchor for the absolutely positioned density control. */
    .admin-content { position: relative; }
    /* Posts grid only: column count is driven by --admin-cols so the control
       can change it without re-rendering. Cards drop their fixed width and let
       the track size them. Because the variable lives on :root, batches swapped
       in by the infinite-scroll sentinel pick it up with no extra wiring. */
    .admin-grid.adjustable {
      display: grid;
      grid-template-columns: repeat(var(--admin-cols, 6), minmax(0, 1fr));
      align-items: start;
    }
    .admin-grid.adjustable .admin-card { width: auto; }
    .admin-grid.adjustable .admin-sentinel { grid-column: 1 / -1; }
    .admin-density {
      position: absolute;
      top: 0;
      right: 0;
      z-index: 10;
      display: flex;
      align-items: center;
      gap: .5rem;
      padding: .4rem .6rem;
      font-size: .8rem;
      background: var(--main-bg-color, #fff);
      border: 1px solid var(--main-border-color, #ccc);
      border-radius: 4px;
    }
    .admin-density output { min-width: 1.5em; text-align: right; font-weight: bold; }
    .admin-card img { width: 100%; height: auto; display: block; border: 1px solid #ccc; }
    .admin-card.deleted img { opacity: .4; }
    .banner-card { width: 260px; }
    .banner-card.flagged img { opacity: .35; outline: 2px solid #7a1020; }
    .admin-table { width: 100%; border-collapse: collapse; }
    .admin-table th, .admin-table td { text-align: left; padding: .35rem .5rem; border-bottom: 1px solid #ddd; }
    .admin-tag { font-size: .7rem; padding: .1rem .3rem; border-radius: 3px; border: 1px solid currentColor; }
    .admin-tag.draft { color: #8a6d00; }
    .admin-tag.deleted { color: #7a1020; }
    .admin-tag.private { color: #4a2a7a; }
    .admin-tag.unlisted { color: #2a5a7a; }
    .admin-tag.sensitive { color: #7a1020; }
    .admin-pager { margin-top: 1rem; display: flex; gap: 1rem; }
    .admin-sort-active { font-weight: bold; }
    /* Full-width so it always enters the viewport and fires hx-trigger="revealed",
       even when the last row of cards does not fill the grid. */
    .admin-sentinel { width: 100%; padding: 1rem; text-align: center; }
  </style>
{% endblock head %}
{% block content %}
  <div class="admin-banner">
    ADMIN — showing content that bypasses normal visibility rules
  </div>
  <nav class="admin-nav">
    <a href="/admin/posts">All posts</a>
    <a href="/admin/users">Users</a>
    <a href="/admin/communities">Communities</a>
    <a href="/admin/banners">Banners</a>
    <a href="/">← Back to site</a>
  </nav>
  <div class="admin-content">
    {% block admin_content %}
    {% endblock admin_content %}
  </div>
{% endblock content %}
