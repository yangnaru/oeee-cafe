{% extends "base.jinja" %}
{# Staff-only chrome. The banner is deliberately loud: these pages show private
   communities, unpublished drafts and removed posts, so it should never be
   ambiguous which context you are looking at. #}
{% block title %}Admin · {{ ftl_get_message("brand") }}{% endblock title %}
{% block head %}
  <style>
    .admin-banner {
      background: #7a1020;
      color: #fff;
      padding: .5rem 1rem;
      margin-bottom: 1rem;
      font-weight: bold;
    }
    .admin-banner a { color: #fff; }
    .admin-nav { display: flex; gap: 1rem; margin-bottom: 1rem; flex-wrap: wrap; }
    .admin-filters { margin-bottom: 1rem; display: flex; gap: .75rem; align-items: end; flex-wrap: wrap; }
    .admin-grid { display: flex; flex-wrap: wrap; gap: .75rem; }
    .admin-card { width: 160px; font-size: .85rem; }
    .admin-card img { width: 100%; height: auto; display: block; border: 1px solid #ccc; }
    .admin-card.deleted img { opacity: .4; }
    .admin-table { width: 100%; border-collapse: collapse; }
    .admin-table th, .admin-table td { text-align: left; padding: .35rem .5rem; border-bottom: 1px solid #ddd; }
    .admin-tag { font-size: .7rem; padding: .1rem .3rem; border-radius: 3px; border: 1px solid currentColor; }
    .admin-tag.draft { color: #8a6d00; }
    .admin-tag.deleted { color: #7a1020; }
    .admin-tag.private { color: #4a2a7a; }
    .admin-tag.unlisted { color: #2a5a7a; }
    .admin-tag.sensitive { color: #7a1020; }
    .admin-pager { margin-top: 1rem; display: flex; gap: 1rem; }
  </style>
{% endblock head %}
{% block content %}
  <div class="admin-banner">
    ADMIN — showing content that bypasses normal visibility rules
  </div>
  <nav class="admin-nav">
    <a href="/admin/posts">All posts</a>
    <a href="/admin/users">Users</a>
    <a href="/admin/communities">Communities</a>
    <a href="/">← Back to site</a>
  </nav>
  {% block admin_content %}
  {% endblock admin_content %}
{% endblock content %}
