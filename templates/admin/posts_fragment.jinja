{# One batch of post cards plus the sentinel that pulls the next batch.
   Rendered both inside admin/posts.jinja (first batch) and standalone by
   /admin/posts-fragment (subsequent batches), so it must not depend on
   anything the fragment handler does not pass.

   The card itself is the same component the public feeds use, with admin=true
   swapping in the /admin link targets and the moderation tags. #}
{% import "post_card.jinja" as card %}
{% for post in posts %}
  {{ card.post_card(post, r2_public_endpoint_url, true) }}
{% endfor %}

{% if has_more %}
  <div class="admin-sentinel"
       hx-get="{{ next_url }}"
       hx-trigger="revealed"
       hx-swap="outerHTML">
    <span class="muted">Loading more…</span>
  </div>
{% endif %}
