{# One batch of notification rows plus the sentinel that pulls the next batch.
   Rendered inline by notifications.jinja for the first batch and standalone by
   /api/notifications/items for every scrolled batch, so it must not depend on
   anything that handler does not pass. #}
{% for notification in notifications %}
  {% include "notification_item.jinja" %}
{% endfor %}

{% if has_more %}
  <div class="infinite-scroll-sentinel"
       hx-get="{{ next_url }}"
       hx-trigger="revealed"
       hx-swap="outerHTML">
    <span class="loading-indicator">{{ ftl_get_message("loading-more-posts") }}</span>
  </div>
{% endif %}
