{% extends "base.jinja" %}
{% block title %}
  {{ super() }} | {{ ftl_get_message("collaborate-title") }}
{% endblock title %}
{% block head %}
  {# Same page width and column-restore script the / and /home feeds use, so the
     finished-drawings grid behaves identically here. #}
  {% include "post_feed_head.jinja" %}
{% endblock head %}
{# One tier of the community picker. data-search is what the filter box matches
   against, lowercased server-side so the script only has to lowercase the
   query. #}
{% macro community_options(communities, group_label, selected_slug) %}
  {% if communities %}
    <optgroup label="{{ group_label }}">
      {% for community in communities %}
        <option value="{{ community.id }}" data-search="{{ (community.name ~ " " ~ community.slug ~ " @" ~ community.owner_login_name ~ " " ~ (community.description or ""))|lower }}" {% if community.slug == selected_slug %}selected{% endif %}>{{ community.name }}{% if community.visibility == "unlisted" %} ({{ ftl_get_message("community-badge-unlisted") }}){% elif community.visibility == "private" %} ({{ ftl_get_message("community-badge-private") }}){% endif %}</option>
      {% endfor %}
    </optgroup>
  {% endif %}
{% endmacro %}
{% block content %}
  <div class="center">
    <h2>{{ ftl_get_message("collaborate-title") }}</h2>
    {# Signed-out visitors can browse the gallery below; only creating a
       session needs an account. #}
    {% if current_user %}
      <div class="create-session-section">
        <h3>{{ ftl_get_message("collaborate-create-session") }}</h3>
      <form id="create-session-form" method="post" action="/collaborate">
        <p>
          <label for="canvas-size">{{ ftl_get_message("collaborate-canvas-size-label") }}:</label>
          <select id="canvas-size" name="canvas-size" required>
            {% for size_value, size_label in canvas_sizes %}<option value="{{ size_value }}">{{ size_label }}</option>{% endfor %}
          </select>
        </p>
        <p>
          <label for="session-title">{{ ftl_get_message("collaborate-session-title-label") }}:</label>
          <input type="text"
                 id="session-title"
                 name="title"
                 maxlength="100"
                 placeholder="{{ ftl_get_message("collaborate-session-title-placeholder") }}">
        </p>
        <p>
          <label for="max-participants">{{ ftl_get_message("collaborate-max-participants-label") }}:</label>
          <select id="max-participants" name="max_participants" required>
            <option value="2">2 {{ ftl_get_message("collaborate-participants") }}</option>
            <option value="4" selected>4 {{ ftl_get_message("collaborate-participants") }}</option>
            <option value="6">6 {{ ftl_get_message("collaborate-participants") }}</option>
            <option value="8">8 {{ ftl_get_message("collaborate-participants") }}</option>
          </select>
        </p>
        <p>
          <label for="is-public">
            <input type="checkbox" id="is-public" name="is_public" checked>
            {{ ftl_get_message("collaborate-public-session-label") }}
          </label>
        </p>
        <small>{{ ftl_get_message("collaborate-public-session-description") }}</small>
        {% if has_postable_communities %}
          <div class="community-field">
            <label for="session-community">{{ ftl_get_message("collaborate-community-label") }}:</label>
            {# The select is the working control on its own; the filter box is
               unhidden by script, so a no-JS visitor still gets every option
               and the tiers stay in priority order. #}
            <input type="search"
                   id="community-filter"
                   class="community-filter"
                   autocomplete="off"
                   hidden
                   aria-controls="session-community"
                   data-no-matches="{{ ftl_get_message("collaborate-community-no-matches") }}"
                   placeholder="{{ ftl_get_message("collaborate-community-search-placeholder") }}">
            <select id="session-community" name="community_id">
              <option value="">{{ ftl_get_message("collaborate-community-none") }}</option>
              {{ community_options(member_communities, ftl_get_message("collaborate-community-group-yours"), selected_community_slug) }}
              {{ community_options(participated_communities, ftl_get_message("collaborate-community-group-participated"), selected_community_slug) }}
              {{ community_options(other_communities, ftl_get_message("collaborate-community-group-public"), selected_community_slug) }}
            </select>
            <small class="community-field-hint">{{ ftl_get_message("collaborate-community-hint") }}</small>
          </div>
        {% endif %}
        <input type="submit" value="{{ ftl_get_message("collaborate-create-button") }}">
      </form>
      </div>
    {% else %}
      <div class="create-session-section">
        <p>
          <a href="/login?next=/collaborate">{{ ftl_get_message("collaborate-sign-in-to-create") }}</a>
        </p>
      </div>
    {% endif %}
    {% if active_sessions|length > 0 %}
      <div class="active-sessions-section">
        <h3>{{ ftl_get_message("collaborate-active-sessions") }}</h3>
        <div class="sessions-grid">
          {% for session in active_sessions %}
            <div class="session-card">
              <div class="session-header">
                {% if session.title %}
                  <h4>{{ session.title }}</h4>
                {% else %}
                  <h4>{{ ftl_get_message("post-no-title") }}</h4>
                {% endif %}
                <small>
                  <a href="/@{{ session.owner_login_name }}">@{{ session.owner_login_name }}</a>
                </small>
              </div>
              <div class="session-info">
                <div class="session-meta">
                  <span class="canvas-size">{{ session.width }}×{{ session.height }}</span>
                  {# Seats taken out of seats total: a bare count gives no sense
                     of whether there is room to join. #}
                  <span class="participant-count">{{ session.participant_count }} / {{ session.max_participants }} {{ ftl_get_message("collaborate-participants") }}</span>
                  <span class="session-time">{{ ftl_get_message("collaborate-session-created") }} {{ session.created_at|dateformat(format="short", tz="Asia/Seoul") }}</span>
                </div>
                {# Where the finished drawing will be posted. Worth knowing
                   before joining, and it is the same choice the create form
                   above makes. #}
                {% if session.community_slug %}
                  <p class="session-community">
                    <a href="/communities/@{{ session.community_slug }}">{{ session.community_name }}</a>
                  </p>
                {% endif %}
              </div>
              <div class="session-actions">
                <a href="/collaborate/{{ session.id }}">{{ ftl_get_message("collaborate-join-session") }}</a>
              </div>
            </div>
          {% endfor %}
        </div>
      </div>
    {% endif %}
    {# Finished collaborative drawings, through the same card template as the
       home grid so they carry the community label and sensitive handling. #}
    {% if feed.posts and feed.posts|length > 0 %}
      <section role="region" aria-labelledby="collab-gallery-heading">
        <div class="feed-header">
          <h3 id="collab-gallery-heading" class="home-section-title">{{ ftl_get_message("collaborate-finished-drawings") }}</h3>
          {% include "post_feed_controls.jinja" %}
        </div>
        <div class="posts-grid" id="post-feed-grid">
          {% include "post_feed_fragment.jinja" %}
        </div>
      </section>
    {% endif %}
  </div>
  <style>
    /* Oeee Cafe style collaborative lobby */
    /* The page took the feeds' 1600px width so the gallery has room, but a form
       of short controls stretched that far reads as an empty box. Only the grid
       below wants the extra width. */
    .create-session-section {
      background-color: var(--main-nav-bg-color);
      border: 1px solid var(--main-border-color);
      padding: 8px;
      margin-bottom: 8px;
      max-width: 829px;
    }
    
    .create-session-section h3 {
      margin: 0 0 8px 0;
    }
    
    .create-session-section p {
      margin: 8px 0;
    }
    
    .create-session-section label {
      font-weight: normal;
    }
    
    .create-session-section select,
    .create-session-section input[type="text"] {
      font-family: inherit;
      font-size: inherit;
    }
    
    .create-session-section small {
      font-size: 0.9em;
      color: var(--main-text-color);
      opacity: 0.7;
    }
    
    .create-session-section input[type="submit"] {
      margin-top: 8px;
    }

    /* The community picker is two stacked controls under one label, so it
       cannot use the single-line <p> layout the rest of the form uses. */
    .community-field {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 4px;
      margin: 8px 0;
    }

    .community-field .community-filter,
    .community-field select {
      font-family: inherit;
      font-size: inherit;
      max-width: 100%;
      min-width: min(320px, 100%);
    }

    .community-field-hint {
      font-size: 0.9em;
      opacity: 0.7;
    }

    .session-community {
      margin: 4px 0 0 0;
      font-size: 0.9em;
    }

    .active-sessions-section {
      margin-top: 8px;
    }
    
    .active-sessions-section h3 {
      padding: 8px;
      background-color: var(--main-nav-bg-color);
      border: 1px solid var(--main-border-color);
      margin: 0 0 8px 0;
    }
    
    .sessions-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: 8px;
    }
    
    .session-card {
      border: 1px solid var(--main-border-color);
      padding: 8px;
      background-color: var(--main-bg-color);
    }
    
    .session-header h4 {
      margin: 0 0 4px 0;
      color: var(--main-text-color);
    }
    
    .session-header small {
      color: var(--main-text-color);
      opacity: 0.7;
    }
    
    .session-info {
      margin: 8px 0;
    }
    
    .session-meta {
      display: flex;
      gap: 8px;
      margin-bottom: 4px;
      flex-wrap: wrap;
    }
    
    .session-meta span {
      background-color: var(--main-nav-bg-color);
      border: 1px solid var(--main-border-color);
      padding: 2px 4px;
      font-size: 0.9em;
    }
    
    .session-actions {
      text-align: right;
    }
    
    .session-actions input[type="submit"],
    .session-actions a {
      background-color: var(--main-nav-bg-color);
      border: 1px solid var(--main-border-color);
      color: var(--main-text-color);
      padding: 4px 8px;
      text-decoration: none;
      display: inline-block;
      cursor: pointer;
    }
    
    .session-actions input[type="submit"]:hover,
    .session-actions a:hover {
      background-color: var(--main-border-color);
    }
  </style>
  {# Only ship with the form: getElementById would be null signed out and
     the TypeError would break any later script on the page. #}
  {% if current_user %}
  <script>
    document.getElementById('create-session-form').addEventListener('submit', async function(e) {
      e.preventDefault();
      
      const formData = new FormData(e.target);
      const canvasSize = formData.get('canvas-size').split('x');
      const width = parseInt(canvasSize[0]);
      const height = parseInt(canvasSize[1]);
      
      const requestData = {
        title: formData.get('title') || null,
        width: width,
        height: height,
        is_public: formData.get('is_public') === 'on',
        max_participants: parseInt(formData.get('max_participants')),
        // Empty means a personal session; the server treats "" as None. A
        // saved session becomes a post in whichever community is chosen here.
        community_id: formData.get('community_id') || null
      };
      
      try {
        const response = await fetch('/collaborate', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(requestData)
        });
        
        if (response.ok) {
          const result = await response.json();
          window.location.href = result.url;
        } else {
          alert('Failed to create session. Please try again.');
        }
      } catch (error) {
        console.error('Error creating session:', error);
        alert('Failed to create session. Please check your connection and try again.');
      }
    });
  </script>
  <script>
    // Filters the community select down to matching options. The select keeps
    // its optgroup order — members first, then communities the user has posted
    // in — so typing narrows a list that is already in priority order rather
    // than replacing it with a differently ranked one.
    (function () {
      function init() {
        var filter = document.getElementById("community-filter");
        var select = document.getElementById("session-community");
        // The picker is omitted entirely when the user can post nowhere.
        if (!filter || !select) return;

        // Snapshot before the first filter run: rebuilding from the live DOM
        // would permanently drop whatever the previous query hid.
        var groups = [];
        Array.prototype.forEach.call(select.children, function (child) {
          if (child.tagName === "OPTGROUP") {
            groups.push({
              label: child.label,
              options: Array.prototype.slice.call(child.children),
            });
          }
        });
        var none = select.querySelector('option[value=""]');
        var empty = document.createElement("option");
        empty.disabled = true;
        // Carried on the input rather than interpolated into this script: the
        // translation is arbitrary text and attribute escaping is the only
        // context minijinja can escape it for correctly.
        empty.textContent = filter.dataset.noMatches;

        function apply() {
          var query = filter.value.toLowerCase().trim();
          // Keeping the selection visible matters: filtering it out would post
          // the drawing to a community the user can no longer see they picked.
          var selected = select.value;
          var matched = 0;

          select.textContent = "";
          select.appendChild(none);
          groups.forEach(function (group) {
            var hits = group.options.filter(function (option) {
              if (query === "" || (option.dataset.search || "").indexOf(query) !== -1) {
                matched++;
                return true;
              }
              // Kept but not counted: a lone surviving selection is not a hit,
              // and reporting it as one would hide "no matches" entirely.
              return option.value === selected;
            });
            if (!hits.length) return;
            var optgroup = document.createElement("optgroup");
            optgroup.label = group.label;
            hits.forEach(function (option) {
              optgroup.appendChild(option);
            });
            select.appendChild(optgroup);
          });
          if (!matched) select.appendChild(empty);

          select.value = selected;
        }

        filter.hidden = false;
        filter.addEventListener("input", apply);
        // Enter in a search field submits the form; here it should only filter.
        filter.addEventListener("keydown", function (e) {
          if (e.key === "Enter") e.preventDefault();
        });
      }

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", init);
      } else {
        init();
      }
    })();
  </script>
  {% endif %}
{% endblock content %}
