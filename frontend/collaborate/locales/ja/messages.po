#: ../frontend/collaborate/components/SessionHeader.tsx:66
msgid "Share"
msgstr "共有"

#: ../frontend/collaborate/components/SessionExpiredModal.tsx:88
msgid ""
"This collaborative session has ended due to inactivity. As the owner, you "
"can save it to the gallery or download it as a PNG."
msgstr ""
"非アクティブのためコラボレーションセッションが終了しました。オーナーとして、"
"ギャラリーに保存するか PNG としてダウンロードできます。"

#: ../frontend/collaborate/components/SessionExpiredModal.tsx:87
msgid ""
"This collaborative session has ended due to inactivity. The session has "
"already been saved to the gallery, but you can download it as a PNG."
msgstr ""
"非アクティブのためコラボレーションセッションが終了しました。セッションはすで"
"にギャラリーに保存されていますが、PNG としてダウンロードできます。"

#: ../frontend/collaborate/components/SessionExpiredModal.tsx:89
msgid ""
"This collaborative session has ended due to inactivity. You can save your "
"work locally as a PNG before leaving."
msgstr ""
"非アクティブのためコラボレーションセッションが終了しました。退出前にローカル"
"に PNG として保存できます。"

#: ../frontend/collaborate/components/SessionExpiredModal.tsx:45
msgid "This session has already been saved. You can only download it as a PNG."
msgstr ""
"このセッションはすでに保存されています。PNG としてのみダウンロードできます。"

#: ../frontend/collaborate/components/modals/RoomFullModal.tsx:25
msgid ""
"This session is full ({currentUserCount}/{maxUsers} users). Only the first "
"{maxUsers} users can join a session."
msgstr ""
"このセッションは満員です（{currentUserCount}/{maxUsers}ユーザー）。最初の"
"{maxUsers}ユーザーのみがセッションに参加できます。"

#: ../frontend/collaborate/components/Chat.tsx:242
msgid "Type a message..."
msgstr "メッセージを入力..."

#: ../frontend/collaborate/components/modals/AuthErrorModal.tsx:19
msgid ""
"Unable to authenticate your session. Either the session doesn't exist, or it "
"has expired. Please return to the lobby."
msgstr ""
"セッションを認証できません。セッションが存在しないか、期限切れです。ロビーに"
"戻ってください。"

#: ../frontend/collaborate/components/modals/SessionEndingModal.tsx:20
msgid "You'll be redirected to the post page shortly."
msgstr "まもなく投稿ページにリダイレクトされます。"

